{
  "name": "meyplayer",
  "productName": "MeyPlayer",
  "version": "1.0.0",
  "description": "MeyPlayer - video & music player for Windows and Android",
  "author": {
    "name": "Kamil"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "android:init": "npx cap add android && node scripts/patch-android.js && npx cap sync android",
    "android:apk": "cd android && ./gradlew assembleRelease",
    "android:debug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/screen-orientation": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.meyplayer.app",
    "productName": "MeyPlayer",
    "copyright": "Copyright © 2026 Kamil",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "www/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}",
      "signtoolOptions": {
        "publisherName": "Kamil"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MeyPlayer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MeyPlayer-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "MeyPlayer-Portable-${version}.exe"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "webm",
          "mov",
          "m4v",
          "avi",
          "3gp",
          "ts"
        ],
        "name": "Video",
        "description": "Video file",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": [
          "mp3",
          "m4a",
          "aac",
          "wav",
          "ogg",
          "opus",
          "flac"
        ],
        "name": "Audio",
        "description": "Audio file",
        "role": "Viewer",
        "icon": "build/icon.ico"
      }
    ]
  }
}
